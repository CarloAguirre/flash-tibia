MiniWindow
  id: farmingMaterialsWindow
  !text: tr('Materials & Build')
  height: 214
  &save: true

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: miniwindowScrollBar.left
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-right: 8
    margin-top: 2
    padding-top: 2

    Label
      id: woodLabel
      !text: tr('Wood')
      anchors.top: parent.top
      anchors.left: parent.left
      color: #d7d7d7ff

    Label
      id: woodValue
      text: 0
      width: 48
      anchors.top: woodLabel.top
      anchors.right: parent.right
      margin-right: 2
      color: #f0df9fff
      text-align: right

    Panel
      id: woodBuildRow
      height: 32
      anchors.top: woodLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2

      UIItem
        id: woodWall
        size: 30 30
        virtual: true
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        border-width: 1
        border-color: #5a5a5aff

      UIItem
        id: woodDoor
        size: 30 30
        virtual: true
        anchors.left: woodWall.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        border-width: 1
        border-color: #5a5a5aff

      UIItem
        id: woodWindow
        size: 30 30
        virtual: true
        anchors.left: woodDoor.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        border-width: 1
        border-color: #5a5a5aff

    Label
      id: stoneLabel
      !text: tr('Stone')
      anchors.top: woodBuildRow.bottom
      anchors.left: parent.left
      margin-top: 4
      color: #d7d7d7ff

    Label
      id: stoneValue
      text: 0
      width: 48
      anchors.top: stoneLabel.top
      anchors.right: parent.right
      margin-right: 2
      color: #c9d1d9ff
      text-align: right

    Panel
      id: stoneBuildRow
      height: 32
      anchors.top: stoneLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2

      UIItem
        id: stoneWall
        size: 30 30
        virtual: true
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        border-width: 1
        border-color: #5a5a5aff

      UIItem
        id: stoneDoor
        size: 30 30
        virtual: true
        anchors.left: stoneWall.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        border-width: 1
        border-color: #5a5a5aff

      UIItem
        id: stoneWindow
        size: 30 30
        virtual: true
        anchors.left: stoneDoor.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 4
        border-width: 1
        border-color: #5a5a5aff

    HorizontalSeparator
      id: buildSeparator
      anchors.top: stoneBuildRow.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 5

    Label
      id: buildSelection
      !text: tr('Select a structure')
      anchors.top: buildSeparator.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      color: #d7d7d7ff
      text-align: center

    Label
      id: buildQueue
      !text: tr('Click map squares to plan')
      anchors.top: buildSelection.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      color: #9d9d9dff
      text-align: center
      font: verdana-9px

    Button
      id: confirmBuild
      !text: tr('Build')
      width: 52
      height: 20
      anchors.top: buildQueue.bottom
      anchors.left: parent.left
      margin-top: 4
      enabled: false

    Button
      id: cancelBuild
      !text: tr('Cancel')
      width: 52
      height: 20
      anchors.top: confirmBuild.top
      anchors.right: parent.right
      enabled: false

    Label
      id: farmingStatus
      !text: tr('Ready')
      anchors.top: confirmBuild.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      color: #9d9d9dff
      text-align: center
      font: verdana-9px
