Module
  name: game_farming
  description: Eldera resource farming and materials wallet
  author: Eldera
  sandboxed: true
  autoload: true
  autoload-priority: 1000
  dependencies: [ game_interface, game_attachedeffects ]
  scripts: [ wheat_glow, farming ]
  @onLoad: |
    init()
    initWheatGlow()
  @onUnload: |
    terminateWheatGlow()
    terminate()
