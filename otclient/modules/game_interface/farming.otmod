Module
  name: game_farming
  description: Eldera resource farming, materials wallet and construction planning
  author: Eldera
  sandboxed: true
  autoload: true
  autoload-priority: 1000
  dependencies: [ game_interface, game_shaders ]
  scripts: [ farming, farming_siege ]
  @onLoad: |
    init()
    initSiege()
  @onUnload: |
    terminateSiege()
    terminate()