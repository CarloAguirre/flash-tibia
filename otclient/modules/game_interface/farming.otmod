Module
  name: game_farming
  description: Eldera resource farming, materials wallet and construction planning
  author: Eldera
  sandboxed: true
  autoload: true
  autoload-priority: 1000
  dependencies: [ game_interface, game_shaders ]
  scripts: [ farming ]
  @onLoad: |
    init()
    local siegeLoaded = pcall(dofile, 'farming_siege')
    if siegeLoaded and initSiege then
      -- farming.lua registers opcode 217 before farming_siege.lua replaces the
      -- global onExtendedOpcode function. Re-register it so siege receives build
      -- completion/status packets and can clear special prebuilds correctly.
      ProtocolGame.unregisterExtendedOpcode(217)
      ProtocolGame.registerExtendedOpcode(217, onExtendedOpcode)

      -- farming_siege's bootstrap configures the UI immediately and also schedules
      -- a second configure pass 350ms later. Re-wrapping Build/Rotate/Cancel makes
      -- the normal Build callback point to its own wrapper and recurse forever.
      -- Suppress only that duplicate bootstrap event, then request siege status
      -- separately after the UI has settled.
      local originalScheduleEvent = scheduleEvent
      local skippedSiegeBootstrap = false
      scheduleEvent = function(callback, delay)
        if not skippedSiegeBootstrap and delay == 350 then
          skippedSiegeBootstrap = true
          return nil
        end
        return originalScheduleEvent(callback, delay)
      end

      initSiege()
      scheduleEvent = originalScheduleEvent

      originalScheduleEvent(function()
        if g_game.isOnline() then
          local protocol = g_game.getProtocolGame()
          if protocol then
            protocol:sendExtendedOpcode(217, 'siege|status')
          end
        end
      end, 350)

      local catapultV2Loaded = pcall(dofile, 'farming_catapult_v2')
      if catapultV2Loaded and initCatapultV2 then
        originalScheduleEvent(function()
          initCatapultV2()
        end, 450)
      end

      local floorBuildLoaded = pcall(dofile, 'farming_floor_build')
      if floorBuildLoaded and initFloorBuild then
        -- Run after the catapult wrapper so floor mode becomes the outermost
        -- shared Build/Cancel/map handler and can cleanly delegate when inactive.
        originalScheduleEvent(function()
          initFloorBuild()
        end, 550)
      end

      local selectionGuardLoaded = pcall(dofile, 'farming_selection_guard')
      if selectionGuardLoaded and initFarmingSelectionGuard then
        -- Install last: it sees the final wrapped handlers and guarantees every
        -- new construction selection first releases any previous mode.
        originalScheduleEvent(function()
          initFarmingSelectionGuard()
        end, 650)
      end
    end
  @onUnload: |
    if terminateFarmingSelectionGuard then
      terminateFarmingSelectionGuard()
    end
    if terminateFloorBuild then
      terminateFloorBuild()
    end
    if terminateCatapultV2 then
      terminateCatapultV2()
    end
    if terminateSiege then
      terminateSiege()
    end
    terminate()